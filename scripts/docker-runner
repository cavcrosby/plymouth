#!/bin/bash
#
# Runs commands in a Docker container.

set -eo pipefail

if ! [ "$(docker container ls --quiet --filter "name=^debian$")" ]; then
    docker container run \
        --detach \
        --tty \
        --name "debian" \
        --mount "type=bind,src=${PWD}/..,dst=/build" \
        --mount "type=bind,src=${PWD},dst=/build/plymouth" \
        "debian:trixie"
fi

docker container exec --workdir "/build/plymouth" "debian" "./scripts/setup"
docker container exec \
    --workdir "/build/plymouth" \
    --user "$(id --user)" \
    "debian" \
    "./scripts/build-pkgs"
