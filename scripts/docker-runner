#!/bin/bash
#
# Runs commands in a Docker container.

set -eo pipefail

if ! [ "$(command -v docker)" ]; then
    printf "%s: %s\n" "${PROGNAME}" "docker cannot be found in the PATH!" >&2
    exit 1
fi

if ! [ "$(docker container ls --quiet --filter "name=^debian$")" ]; then
    docker container run \
        --detach \
        --tty \
        --name "debian" \
        --mount "type=bind,src=${PWD}/..,dst=/mnt" \
        --mount "type=bind,src=${PWD},dst=/mnt/plymouth" \
        "debian:trixie"
fi

docker container exec --workdir "/mnt/plymouth" "debian" "./scripts/setup"
docker container exec \
    --workdir "/mnt/plymouth" \
    --user "$(id --user)" \
    "debian" \
    "./scripts/build-pkgs"
